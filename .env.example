# Copy to .env. Variables already set in the shell win over this file.

# Postgres from docker compose. Used by pnpm migrate, pnpm seed, pnpm start and pnpm chat.
DATABASE_URL=postgres://servicedesk:servicedesk@localhost:5432/voice_service_desk
# Database the test suites create, migrate and seed; tests run with DATABASE_URL set to this.
TEST_DATABASE_URL=postgres://servicedesk:servicedesk@localhost:5432/voice_service_desk_test

# API listen address and port. 127.0.0.1 keeps the API local; Compose sets HOST=0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=3000
# Requests allowed per one-minute window. Per source IP: new sessions (POST /v1/session and voice connects) and turns
# together. Per session: turns on /v1/turn and the voice socket.
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_SESSION_PER_MIN=20

# Model server: any server that implements the OpenAI chat completions API and GET /models.
# openai-compatible = native tool calling, json-mode = tool schemas in the prompt for models without
# tool calling, scripted = replays LLM_SCRIPT with no network calls.
LLM_PROVIDER=openai-compatible
# Base URL of the server's OpenAI-compatible API as this machine reaches it, usually ending in /v1, for example
# http://localhost:8080/v1. Used by pnpm start, pnpm chat, pnpm seed (RAG_MODE=hybrid) and pnpm test:scenarios:local.
LLM_BASE_URL=
# The same server as the api container in docker compose reaches it, for example http://host.docker.internal:8080/v1
# (localhost inside the container is the container itself). Empty = the container uses LLM_BASE_URL.
DOCKER_LLM_BASE_URL=
# Model id exactly as GET $LLM_BASE_URL/models lists it. Startup exits with an error if it is not listed.
LLM_MODEL=
# Bearer token sent to the model server. Servers without auth accept any value.
LLM_API_KEY=not-needed
# Path to a YAML or JSON list of scripted model responses, used when LLM_PROVIDER=scripted.
LLM_SCRIPT=

# Retrieval: fts = Postgres full-text search; hybrid = also embeddings from EMBEDDING_MODEL on the model server.
RAG_MODE=fts
# Minimum score (0 to 1) for a knowledge base chunk to count as a match. 0.7 is calibrated on the seeded articles:
# IT questions mostly score 0.75 to 0.94, unrelated ones at most 0.62. Re-check it after changing articles or RAG_MODE.
RAG_MIN_SCORE=0.7
# Embedding model id on the model server. Needed only when RAG_MODE=hybrid; health check confirms it is listed.
EMBEDDING_MODEL=
# Size of the embedding vectors. Read when migrations run, so set it before the first pnpm migrate.
EMBEDDING_DIM=768

# Speech to text: text = typed passthrough with no audio (REPL and tests); transcribe = Amazon Transcribe streaming.
STT_PROVIDER=text
# Transcribe language. en-US is the only supported value.
STT_LANGUAGE=en-US
# Text to speech: text = returns the reply as a text frame; polly = Amazon Polly neural voice, 16 kHz PCM.
TTS_PROVIDER=text
# The one Polly voice used for every reply.
TTS_VOICE_ID=Joanna

# AWS region for Transcribe and Polly. Credentials come from the standard AWS SDK chain (shared config/profile,
# SSO, container or instance role) or from AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN.
AWS_REGION=us-east-1
